{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug jrm (GCC)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/gcc/debug/bin/jrm",
            "args": [
                "${workspaceFolder}/tests"
            ],
            "cwd": "${workspaceFolder}/tests",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
